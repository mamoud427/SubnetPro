<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Palette SubnetPro (estimée depuis les maquettes Figma) -->
    <Color x:Key="Primary">#1E5BC6</Color>
    <Color x:Key="PrimaryDark">#174A9E</Color>
    <Color x:Key="PrimarySoft">#E8F0FE</Color>

    <Color x:Key="Background">#F5F7FB</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Line">#E3E7EE</Color>

    <Color x:Key="Ink">#111827</Color>
    <Color x:Key="Muted">#6B7280</Color>
    <Color x:Key="Disabled">#C7CCD6</Color>

    <Color x:Key="Danger">#DC2626</Color>
    <Color x:Key="Success">#16A34A</Color>

</ResourceDictionary>