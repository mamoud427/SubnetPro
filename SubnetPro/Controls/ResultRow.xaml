<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Name="root"
    x:Class="SubnetPro.Controls.ResultRow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SubnetPro.Controls">

    <VerticalStackLayout
        x:DataType="controls:ResultRow"
        BindingContext="{x:Reference root}"
        Spacing="2">
        <Label Style="{StaticResource Caption}" Text="{Binding Caption}" />
        <Label
            FontFamily="OpenSansSemibold"
            FontSize="14"
            Text="{Binding Value}" />
    </VerticalStackLayout>
</ContentView>