<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SubnetPro.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="White"
    Shell.NavBarIsVisible="False">

    <!-- Le logo est exactement au centre, comme dans l'écran de démarrage système (fond blanc, même logo) :
         la transition entre les deux est invisible. -->
    <Grid Padding="24" RowDefinitions="*,Auto,*">

        <Image
            Grid.Row="1"
            HeightRequest="96"
            HorizontalOptions="Center"
            Source="logo_subnetpro.png"
            WidthRequest="96" />

        <VerticalStackLayout
            Grid.Row="2"
            Margin="0,16,0,0"
            HorizontalOptions="Center"
            Spacing="2"
            VerticalOptions="Start">
            <Label
                FontFamily="OpenSansSemibold"
                FontSize="26"
                HorizontalTextAlignment="Center"
                Text="SubnetPro" />
            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource Caption}"
                Text="Boîte à outils réseau hors ligne" />
        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Row="2"
            Padding="0,0,0,24"
            HorizontalOptions="Center"
            Spacing="8"
            VerticalOptions="End">
            <ActivityIndicator
                HeightRequest="24"
                IsRunning="True"
                WidthRequest="24" />
            <Label Style="{StaticResource Caption}" Text="Veuillez patienter, chargement…" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>