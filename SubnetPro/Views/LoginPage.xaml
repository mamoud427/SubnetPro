<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SubnetPro.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SubnetPro.ViewModels"
    x:DataType="vm:LoginViewModel"
    BackgroundColor="{StaticResource Surface}"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,24" Spacing="14">

            <!-- Marque -->
            <HorizontalStackLayout Spacing="8">
                <Image
                    HeightRequest="28"
                    Source="logo_subnetpro.png"
                    WidthRequest="28" />
                <VerticalStackLayout VerticalOptions="Center">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="14"
                        Text="SubnetPro" />
                    <Label FontSize="9" Style="{StaticResource Caption}" Text="Boîte à outils réseau hors ligne" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Label Margin="0,8,0,0" Style="{StaticResource Heading}" Text="Connexion" />

            <!-- Identifiant -->
            <VerticalStackLayout Spacing="4">
                <Label Style="{StaticResource SectionLabel}" Text="Identifiant" />
                <Border Style="{StaticResource Field}">
                    <Entry
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        Keyboard="Email"
                        Placeholder="Entrer votre identifiant"
                        ReturnType="Next"
                        Text="{Binding Identifier}"
                        VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- Mot de passe -->
            <VerticalStackLayout Spacing="4">
                <Label Style="{StaticResource SectionLabel}" Text="Mot de passe" />
                <Border Style="{StaticResource Field}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry
                            IsPassword="{Binding IsPasswordHidden}"
                            Placeholder="Entrer votre mot de passe"
                            ReturnCommand="{Binding LoginCommand}"
                            ReturnType="Done"
                            Text="{Binding Password}"
                            VerticalOptions="Center" />
                        <ImageButton
                            Grid.Column="1"
                            Command="{Binding TogglePasswordCommand}"
                            HeightRequest="32"
                            Padding="4"
                            Source="{Binding PasswordToggleIcon}"
                            VerticalOptions="Center"
                            WidthRequest="32" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Label
                IsVisible="{Binding HasError}"
                Style="{StaticResource Caption}"
                Text="{Binding ErrorMessage}"
                TextColor="{StaticResource Danger}" />

            <Button Command="{Binding LoginCommand}" Text="Se connecter" />

            <ActivityIndicator HorizontalOptions="Center" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Label
                FontFamily="OpenSansSemibold"
                FontSize="13"
                HorizontalTextAlignment="Center"
                Text="Mot de passe oublié ?"
                TextColor="{StaticResource Primary}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <BoxView
                Margin="0,6"
                HeightRequest="1"
                Color="{StaticResource Line}" />

            <!-- Création de compte -->
            <VerticalStackLayout Spacing="8">
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource Subtitle}"
                    Text="Pas encore de compte sur cet appareil ?" />
                <Button
                    Command="{Binding GoToRegisterCommand}"
                    Style="{StaticResource OutlineButton}"
                    Text="Créer un compte" />
            </VerticalStackLayout>

            <!-- Rappel hors ligne -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                <Image
                    HeightRequest="14"
                    Source="ic_lock.png"
                    VerticalOptions="Center"
                    WidthRequest="14" />
                <Label
                    Style="{StaticResource Caption}"
                    Text="Données stockées sur l'appareil. SubnetPro fonctionne 100 % hors ligne."
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>