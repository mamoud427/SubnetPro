<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SubnetPro.Views.ResultDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SubnetPro.Controls"
    xmlns:fmt="clr-namespace:SubnetPro.Core.Formatting;assembly=SubnetPro.Core"
    xmlns:vm="clr-namespace:SubnetPro.ViewModels"
    x:DataType="vm:ResultDetailViewModel"
    Title="Détail résultat"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,24" Spacing="14">

            <!-- En-tête avec retour -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="0,4,0,8">
                <ImageButton
                    Command="{Binding GoBackCommand}"
                    HeightRequest="32"
                    Padding="4"
                    Source="ic_back.png"
                    VerticalOptions="Center"
                    WidthRequest="32" />
                <Label
                    Grid.Column="1"
                    FontFamily="OpenSansSemibold"
                    FontSize="15"
                    Text="Détail résultat"
                    VerticalOptions="Center" />
                <controls:OfflineBadge Grid.Column="2" />
            </Grid>

            <VerticalStackLayout Spacing="2">
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="22"
                    Text="{Binding ResultTitle}" />
                <Label Style="{StaticResource Caption}" Text="{Binding DetailSubtitle}" />
            </VerticalStackLayout>

            <!-- Détail d'un sous-réseau -->
            <Border IsVisible="{Binding IsSubnet}" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <FlexLayout
                        AlignItems="Start"
                        BindableLayout.ItemsSource="{Binding ResultItems}"
                        Direction="Row"
                        JustifyContent="Start"
                        Wrap="Wrap">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="fmt:ResultItem">
                                <controls:ResultRow
                                    Margin="0,0,0,12"
                                    Caption="{Binding Caption}"
                                    FlexLayout.Basis="50%"
                                    Value="{Binding Value}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />

                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="12"
                        Text="{Binding ClassLabel}"
                        TextColor="{StaticResource Primary}" />
                </VerticalStackLayout>
            </Border>

            <!-- Détail d'une répartition VLSM -->
            <Border IsVisible="{Binding IsVlsm}" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">

                    <Label Style="{StaticResource SectionLabel}" Text="Répartition obtenue" />

                    <Grid ColumnDefinitions="*,120,48">
                        <Label Style="{StaticResource Caption}" Text="Segment" />
                        <Label
                            Grid.Column="1"
                            Style="{StaticResource Caption}"
                            Text="Réseau / CIDR" />
                        <Label
                            Grid.Column="2"
                            HorizontalTextAlignment="End"
                            Style="{StaticResource Caption}"
                            Text="Hôtes" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding VlsmRows}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="fmt:VlsmRow">
                                <Grid ColumnDefinitions="*,120,48">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="13"
                                            Text="{Binding Name}" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding HostRange}" />
                                    </VerticalStackLayout>
                                    <Label
                                        Grid.Column="1"
                                        FontSize="12"
                                        Text="{Binding NetworkCidr}" />
                                    <Label
                                        Grid.Column="2"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="13"
                                        HorizontalTextAlignment="End"
                                        Text="{Binding UsableHosts}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />

                    <Label
                        IsVisible="{Binding HasWarning}"
                        Style="{StaticResource Caption}"
                        Text="{Binding Warning}"
                        TextColor="{StaticResource Danger}" />
                    <Label Style="{StaticResource Caption}" Text="{Binding VlsmSummary}" />
                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button
                    Command="{Binding CopyCommand}"
                    Style="{StaticResource OutlineButton}"
                    Text="Copier" />
                <Button
                    Grid.Column="1"
                    Command="{Binding ExportCommand}"
                    Style="{StaticResource OutlineButton}"
                    Text="Exporter" />
            </Grid>

            <Button Command="{Binding SaveCommand}" Text="{Binding SaveButtonText}" />

            <Label
                HorizontalTextAlignment="Center"
                IsVisible="{Binding HasStatus}"
                Style="{StaticResource Caption}"
                Text="{Binding StatusMessage}"
                TextColor="{StaticResource Success}" />

            <Label
                Style="{StaticResource Caption}"
                Text="Export au format texte sur l'appareil. Enregistrement dans l'historique local." />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>