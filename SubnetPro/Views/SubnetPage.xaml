<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SubnetPro.Views.SubnetPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SubnetPro.Controls"
    xmlns:fmt="clr-namespace:SubnetPro.Core.Formatting;assembly=SubnetPro.Core"
    xmlns:vm="clr-namespace:SubnetPro.ViewModels"
    x:DataType="vm:SubnetViewModel"
    Title="Sous-réseau">

    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,24" Spacing="14">

            <controls:AppHeader Title="Sous-réseau" />

            <Label Style="{StaticResource Subtitle}" Text="Saisissez une adresse IPv4 et son préfixe CIDR." />

            <!-- Saisie -->
            <Grid
                ColumnDefinitions="*,110"
                ColumnSpacing="10"
                RowDefinitions="Auto,Auto"
                RowSpacing="4">

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource Caption}"
                    Text="Adresse IPv4" />
                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource Caption}"
                    Text="Préfixe CIDR" />

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource Field}">
                    <Entry
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        Keyboard="Text"
                        Placeholder="192.168.10.34"
                        ReturnType="Next"
                        Text="{Binding Address}"
                        VerticalOptions="Center" />
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource Field}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                        <Label
                            FontSize="16"
                            Text="/"
                            TextColor="{StaticResource Muted}"
                            VerticalOptions="Center" />
                        <Entry
                            Grid.Column="1"
                            Keyboard="Numeric"
                            MaxLength="3"
                            Placeholder="24"
                            ReturnCommand="{Binding CalculateCommand}"
                            ReturnType="Done"
                            Text="{Binding CidrText}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>

            <Label
                IsVisible="{Binding HasAddressError}"
                Style="{StaticResource Caption}"
                Text="{Binding AddressError}"
                TextColor="{StaticResource Danger}" />
            <Label
                IsVisible="{Binding HasCidrError}"
                Style="{StaticResource Caption}"
                Text="{Binding CidrError}"
                TextColor="{StaticResource Danger}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Button Command="{Binding CalculateCommand}" Text="Calculer" />
                <Button
                    Grid.Column="1"
                    Command="{Binding ClearCommand}"
                    HeightRequest="46"
                    Style="{StaticResource OutlineButton}"
                    Text="Effacer"
                    WidthRequest="100" />
            </Grid>

            <!-- Résultat -->
            <Border IsVisible="{Binding HasResult}" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <VerticalStackLayout Spacing="2">
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="18"
                            Text="{Binding ResultTitle}" />
                        <Label
                            FontFamily="OpenSansSemibold"
                            FontSize="12"
                            Text="{Binding ClassLabel}"
                            TextColor="{StaticResource Primary}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />

                    <FlexLayout
                        AlignItems="Start"
                        BindableLayout.ItemsSource="{Binding ResultItems}"
                        Direction="Row"
                        JustifyContent="Start"
                        Wrap="Wrap">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="fmt:ResultItem">
                                <controls:ResultRow
                                    Margin="0,0,0,12"
                                    Caption="{Binding Caption}"
                                    FlexLayout.Basis="50%"
                                    Value="{Binding Value}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Button
                        Command="{Binding CopyCommand}"
                        Style="{StaticResource OutlineButton}"
                        Text="Copier le résultat" />

                    <Label
                        HorizontalTextAlignment="Center"
                        IsVisible="{Binding HasStatus}"
                        Style="{StaticResource Caption}"
                        Text="{Binding StatusMessage}"
                        TextColor="{StaticResource Success}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>