<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SubnetPro.Views.VlsmPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SubnetPro.Controls"
    xmlns:fmt="clr-namespace:SubnetPro.Core.Formatting;assembly=SubnetPro.Core"
    xmlns:vm="clr-namespace:SubnetPro.ViewModels"
    x:DataType="vm:VlsmViewModel"
    Title="VLSM">

    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,24" Spacing="14">

            <controls:AppHeader Title="VLSM" />

            <!-- Réseau de départ -->
            <VerticalStackLayout Spacing="4">
                <Label Style="{StaticResource Caption}" Text="Réseau de départ" />
                <Border Style="{StaticResource Field}">
                    <Entry
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        Keyboard="Text"
                        Placeholder="192.168.10.0/24"
                        ReturnCommand="{Binding CalculateCommand}"
                        ReturnType="Done"
                        Text="{Binding NetworkText}"
                        VerticalOptions="Center" />
                </Border>
                <Label
                    IsVisible="{Binding HasNetworkError}"
                    Style="{StaticResource Caption}"
                    Text="{Binding NetworkError}"
                    TextColor="{StaticResource Danger}" />
            </VerticalStackLayout>

            <!-- Besoins -->
            <Label Style="{StaticResource SectionLabel}" Text="Besoins par sous-réseau" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Requirements}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:RequirementRow">
                        <Grid ColumnDefinitions="*,76,Auto,40" ColumnSpacing="8">
                            <Border Style="{StaticResource Field}">
                                <Entry
                                    Placeholder="Nom (ex. Admin)"
                                    Text="{Binding Name}"
                                    VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Field}">
                                <Entry
                                    HorizontalTextAlignment="End"
                                    Keyboard="Numeric"
                                    Placeholder="0"
                                    Text="{Binding HostsText}"
                                    VerticalOptions="Center" />
                            </Border>
                            <Label
                                Grid.Column="2"
                                Style="{StaticResource Caption}"
                                Text="hôtes"
                                VerticalOptions="Center" />
                            <Button
                                Grid.Column="3"
                                Command="{Binding RemoveCommand}"
                                FontSize="20"
                                HeightRequest="46"
                                Padding="0"
                                Style="{StaticResource OutlineButton}"
                                Text="×"
                                TextColor="{StaticResource Danger}"
                                WidthRequest="40" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button
                Command="{Binding AddRequirementCommand}"
                Style="{StaticResource OutlineButton}"
                Text="+ Ajouter un besoin" />

            <Label
                IsVisible="{Binding HasFormError}"
                Style="{StaticResource Caption}"
                Text="{Binding FormError}"
                TextColor="{StaticResource Danger}" />

            <Button Command="{Binding CalculateCommand}" Text="Calculer la répartition" />

            <!-- Résultat -->
            <Border IsVisible="{Binding HasResult}" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">

                    <Label Style="{StaticResource SectionLabel}" Text="Répartition obtenue" />

                    <Grid ColumnDefinitions="*,120,48">
                        <Label Style="{StaticResource Caption}" Text="Segment" />
                        <Label
                            Grid.Column="1"
                            Style="{StaticResource Caption}"
                            Text="Réseau / CIDR" />
                        <Label
                            Grid.Column="2"
                            HorizontalTextAlignment="End"
                            Style="{StaticResource Caption}"
                            Text="Hôtes" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="fmt:VlsmRow">
                                <Grid ColumnDefinitions="*,120,48">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="13"
                                            Text="{Binding Name}" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding HostRange}" />
                                    </VerticalStackLayout>
                                    <Label
                                        Grid.Column="1"
                                        FontSize="12"
                                        Text="{Binding NetworkCidr}" />
                                    <Label
                                        Grid.Column="2"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="13"
                                        HorizontalTextAlignment="End"
                                        Text="{Binding UsableHosts}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />

                    <Label
                        IsVisible="{Binding HasWarning}"
                        Style="{StaticResource Caption}"
                        Text="{Binding Warning}"
                        TextColor="{StaticResource Danger}" />
                    <Label Style="{StaticResource Caption}" Text="{Binding Summary}" />

                    <Button Command="{Binding ShowDetailCommand}" Text="Voir le détail et enregistrer" />

                    <Button
                        Command="{Binding CopyCommand}"
                        Style="{StaticResource OutlineButton}"
                        Text="Copier la répartition" />

                    <Label
                        HorizontalTextAlignment="Center"
                        IsVisible="{Binding HasStatus}"
                        Style="{StaticResource Caption}"
                        Text="{Binding StatusMessage}"
                        TextColor="{StaticResource Success}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>