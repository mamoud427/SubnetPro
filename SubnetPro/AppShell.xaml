<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SubnetPro.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SubnetPro.Views"
    Title="SubnetPro"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <!-- Les Route doivent correspondre à Helpers/Routes.cs.
         Le flux Splash -> Connexion -> Inscription sera ajouté au jour 6. -->
    <TabBar>
        <ShellContent
            Title="Accueil"
            ContentTemplate="{DataTemplate views:HomePage}"
            Icon="ic_home.png"
            Route="home" />
        <ShellContent
            Title="Sous-réseau"
            ContentTemplate="{DataTemplate views:SubnetPage}"
            Icon="ic_subnet.png"
            Route="subnet" />
        <ShellContent
            Title="VLSM"
            ContentTemplate="{DataTemplate views:VlsmPage}"
            Icon="ic_vlsm.png"
            Route="vlsm" />
        <ShellContent
            Title="Classe"
            ContentTemplate="{DataTemplate views:ClassConversionPage}"
            Icon="ic_classe.png"
            Route="classe" />
        <ShellContent
            Title="Historique"
            ContentTemplate="{DataTemplate views:HistoryPage}"
            Icon="ic_history.png"
            Route="history" />
    </TabBar>
</Shell>